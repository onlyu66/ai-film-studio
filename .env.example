# ==============================================================================
# AI FILM STUDIO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Sao chép file này thành .env:
#   cp .env.example .env
# Sau đó điền các API key bạn muốn sử dụng.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDERS (Kịch bản & Phân cảnh)
# ------------------------------------------------------------------------------
# Tùy chọn 1: Google Gemini (Khuyên dùng - Miễn phí gói Free tier, tốc độ siêu nhanh)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash # (Tùy chọn: gemini-3.8-flash, gemini-3.5-flash)

# Tùy chọn 2: Groq Cloud (Miễn phí gói Free tier, Llama-3.3 70B & Mixtral)
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=

# Tùy chọn 3: OpenAI hoặc các nhà cung cấp tương thích (DeepSeek, OpenRouter, v.v.)
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tùy chọn 4: Ollama Local (Mặc định trong Docker, không cần API Key)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 2. MOTION & LIP-SYNC (Video AI động & Cử động môi nhân vật)
# ------------------------------------------------------------------------------
# Replicate API (Dùng cho --motion replicate và --lip-sync cloud)
# Lấy token tại: https://replicate.com/account/api-tokens
# (Có sẵn credit dùng thử miễn phí khi tạo tài khoản)
REPLICATE_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. STUDIO SETTINGS (Tùy chọn cấu hình mặc định)
# ------------------------------------------------------------------------------
# Ngôn ngữ mặc định: vi hoặc en
STUDIO_DEFAULT_LANG=vi

# Phong cách hình ảnh mặc định: cinematic, anime, noir, documentary
STUDIO_DEFAULT_STYLE=cinematic

# Cổng truy cập Web UI (Mặc định: 8080)
# UI_PORT=8080

# ------------------------------------------------------------------------------
# 4. IMAGE GENERATION (AI Visuals)
# ------------------------------------------------------------------------------
# Pollinations.ai API Key (Tùy chọn - Đăng ký key miễn phí tại https://enter.pollinations.ai)
# Khi có key, bạn sẽ được tạo ảnh Flux không giới hạn tốc độ và không bị rate-limit.
# POLLINATIONS_API_KEY=
